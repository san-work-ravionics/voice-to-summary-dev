# Copy to .env and fill in as needed — .env itself is gitignored, never
# commit it. Every value here has a working default (local/free) if unset.

# Which summarization backend the pipelines use by default: local | mistral | claude
SUMMARY_PROVIDER=local

# Only read when SUMMARY_PROVIDER=claude (or --provider claude is passed).
CLAUDE_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# Only read when SUMMARY_PROVIDER=mistral (or --provider mistral is passed).
MISTRAL_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Host port the webapp is published on (docker-compose.yml only).
PORT=8743
