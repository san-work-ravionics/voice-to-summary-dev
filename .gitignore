.venv/
__pycache__/
*.pyc
.DS_Store

# Per-scenario generated output (recordings, transcripts, summaries) —
# regenerated by running each scenario's main.py; not source.
audio-generation/output/
phase1-baseline/output/
phase2-checklist/output/
phase3-context/output/
phase4-assistant/output/
phase5-office-agent/output/
phase6-history/output/
phase7-reference-rag/output/
phase8-voice-query/output/
webapp/.run_status/
logs/

# Real, non-scripted audio a user drops in, plus its derived output —
# never scripted/synthetic like the pipeline's own dummy recordings, must
# never be committed.
custom/audio/
custom/output/

# Regenerated evaluation artifacts (scores/history against on-disk outputs,
# including full transcript/summary text of every judged run).
eval/output/

# Secrets / local machine config.
.env
.env.*
!.env.example
.claude/settings.local.json

# Safety net: model weights are downloaded at runtime into a cache volume,
# never vendored into the repo.
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.gguf
*.ckpt
